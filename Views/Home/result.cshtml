                            <div class="select_wrap w-100">
                                <span class="labelcss">@Resource.Age</span>
                                <div class="select">
                                    @foreach (var range in ageRanges)
                                    {
                                        var isChecked = selectedRanges.Contains(range);
                                        <label>
                                            <input type="checkbox" name="Range" value="@range" @(isChecked ? "checked" : "") />
                                            @range
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>
















