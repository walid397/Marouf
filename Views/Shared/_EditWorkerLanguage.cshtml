@model Marofh.WorkerLanguage
@using Resources
 @using (Html.BeginForm("EditWorkerLanguage", "Worker", FormMethod.Post))
 {
<div class="row">

        <div class="col-12 mt-10">
        @Html.HiddenFor(model => model.ID)
        @Html.HiddenFor(model => model.WorkerID)
            <div class="row">
                <div class="col-12 col-lg-12">
                    <div class="form__group">
                        <label for="firstname" class="form__label">@*اسم اللغة*@ @Resource.language </label>
                        @Html.DropDownList("LanguageID", ViewBag.LanguageID as List<SelectListItem>, htmlAttributes: new { @class = "form-control select2" })

                    </div>
                </div>

                <div class="col-12 col-xl-6 selectcss">
                    <div class="form__group">
                        <label for="location" class="form__label">  @Resource.Reading </label>
                        <select class="select2" name="ReadingMethod" id="ReadingMethod">
                            <option value="">
                                @Resource.Degreeofmastery
                            </option>
                            <option value="@Resource.Low">@Resource.Low</option>
                            <option value="@Resource.Acceptable">@Resource.Acceptable</option>
                            <option value="@Resource.Good">@Resource.Good</option>
                            <option value="@Resource.Moderate">@Resource.Moderate  </option>
                            <option value="@Resource.Excellent">@Resource.Excellent</option>
                        </select>
                    </div>
                </div>
                <div class="col-12 col-xl-6 selectcss">
                    <div class="form__group">
                        <label for="location" class="form__label">  @Resource.Writing </label>
                        <select class="select2" name="writingMethod" id="writingMethod">
                            <option value="">
                                @Resource.Degreeofmastery
                            </option>
                            <option value="@Resource.Low">@Resource.Low</option>
                            <option value="@Resource.Acceptable">@Resource.Acceptable</option>
                            <option value="@Resource.Good">@Resource.Good</option>
                            <option value="@Resource.Moderate">@Resource.Moderate  </option>
                            <option value="@Resource.Excellent">@Resource.Excellent</option>
                        </select>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="form__group">
                        <label for="firstname" class="form__label">@Resource.Speaking</label>
                        <select name="SpeakingMethod" id="SpeakingMethod" class="select2">
                            <option value="">
                                @Resource.Degreeofmastery
                            </option>
                            <option value="@Resource.Low">@Resource.Low</option>
                            <option value="@Resource.Acceptable">@Resource.Acceptable</option>
                            <option value="@Resource.Good">@Resource.Good</option>
                            <option value="@Resource.Moderate">@Resource.Moderate  </option>
                            <option value="@Resource.Excellent">@Resource.Excellent</option>
                           
                        </select>
                    </div>
                </div>
               
            </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-primary"> @Resource.Save</button>
        </div>
    </div>



</div>
    }
